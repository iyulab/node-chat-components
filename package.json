{
  "name": "@iyulab/chat-components",
  "description": "llm chat components for building chat interfaces",
  "version": "0.7.0",
  "author": "iyulab",
  "license": "MIT",
  "keywords": [
    "ai",
    "llm",
    "chat",
    "conversation",
    "components",
    "web-components"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/iyulab/node-chat-components.git"
  },
  "files": [
    "dist",
    "skills",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
