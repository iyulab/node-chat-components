{
  "name": "@iyulab/chat-components",
  "description": "llm chat components for building chat interfaces",
  "version": "0.12.0",
  "author": "iyulab",
  "license": "MIT",
  "keywords": [
    "ai",
    "llm",
    "chat",
    "conversation",
    "components",
    "web-components"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/iyulab/node-chat-components.git"
  },
  "files": [
    "dist",
    "skills",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "./dist/components-extra/U*.js",
    "./src/components-extra/U*.ts",
    "./dist/components/*/U*.js",
    "./src/components/*/U*.ts",
    "./dist/extra.js",
    "./src/extra.ts",
    "./dist/index.js",
    "./src/index.ts",
    "./dist/react/index.js"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./extra": "./src/extra.js",
    "./dist/*": "./src/*",
    "./react": "./dist/react/index.js",
    "./react/*": "./dist/react/*"
  },
  "scripts": {
    "preversion": "node -e \"if(require('fs').existsSync('../../scripts/preversion-check.mjs'))require('child_process').execFileSync('node',['../../scripts/preversion-check.mjs'],{stdio:'inherit'})\"",
    "start": "vite",
    "build": "npm run typecheck && eslint && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "katex": "^0.18.7",
    "lit": "^3.3.3",
    "marked": "^18.0.6"
  },
  "peerDependencies": {
    "@iyulab/components": ">=1.23.0",
    "@lit/react": ">=1.0.8",
    "chart.js": ">=4.5.1",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@lit/react": {
      "optional": true
    },
    "chart.js": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitest/browser-playwright": "^4.1.10",
    "chart.js": "^4.5.1",
    "eslint": "^10.1.0",
    "eslint-plugin-lit": "^2.3.1",
    "glob": "^13.0.6",
    "globals": "^17.7.0",
    "openai": "^6.47.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  }
}
