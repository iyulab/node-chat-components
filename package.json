{
  "name": "@iyulab/chat-components",
  "description": "llm chat components for building chat interfaces",
  "version": "0.1.0",
  "author": "iyulab",
  "license": "MIT",
  "keywords": [
    "llm",
    "ai",
    "chat",
    "conversation",
    "components",
    "web components"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/iyulab/node-chat-components.git"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./styles/*": "./src/assets/styles/*",
    "./components": "./src/components/index.js",
    "./components/*": "./src/components/*",
    "./events": "./src/events/index.js",
    "./events/*": "./src/events/*",
    "./utilities": "./src/utilities/index.js",
    "./utilities/*": "./src/utilities/*"
  },
  "scripts": {
    "build": "eslint src && vite build",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@iyulab/components": "0.0.3",
    "@lit/react": "^1.0.8",
    "dompurify": "^3.3.0",
    "highlight.js": "^11.11.1",
    "lit": "^3.3.1",
    "react": "^19.2.0",
    "marked": "^16.4.1",
    "marked-alert": "^2.1.2",
    "marked-footnote": "^1.4.0",
    "marked-katex-extension": "^5.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.0",
    "eslint-plugin-lit": "^2.1.1",
    "globals": "^16.5.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vite-plugin-dts": "^4.5.4"
  }
}