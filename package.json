{
  "name": "@iyulab/chat-components",
  "description": "llm chat components for building chat interfaces",
  "version": "0.3.0",
  "author": "iyulab",
  "license": "MIT",
  "keywords": [
    "ai",
    "llm",
    "chat",
    "conversation",
    "components",
    "web-components"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/iyulab/node-chat-components.git"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./dist/*": {
      "types": "./src/*.d.ts",
      "import": "./src/*"
    }
  },
  "scripts": {
    "test": "vite",
    "build": "eslint && vite build"
  },
  "dependencies": {
    "@iyulab/components": "^0.3.0",
    "dompurify": "^3.3.1",
    "highlight.js": "^11.11.1",
    "lit": "^3.3.2",
    "marked": "^17.0.3",
    "marked-katex-extension": "^5.1.7",
    "quill": "2.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lit/react": "^1.0.8",
    "@types/node": "^25.3.0",
    "eslint": "^10.0.2",
    "eslint-plugin-lit": "^2.2.1",
    "globals": "^17.3.0",
    "openai": "^6.25.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4"
  }
}