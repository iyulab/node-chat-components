    "./extras": {
      "types": "./src/extras.d.ts",
      "import": "./src/extras.js"
    },
    "./dist/*": "./src/*",
    "./react": "./dist/react/index.js",
    "./react/*": "./dist/react/*"
  },
  "scripts": {
    "test": "vite",
    "build": "eslint && vite build"
  },
  "dependencies": {
    "@iyulab/components": "^1.4.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "lit": "^3.3.3",
