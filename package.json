{
  "name": "@iyulab/chat-components",
  "description": "Chat interface and streaming Markdown blocks for LLM front ends",
  "version": "0.30.0",
  "author": "iyulab",
  "license": "MIT",
  "keywords": [
    "ai",
    "llm",
    "chat",
    "conversation",
    "components",
    "web-components"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/iyulab/node-chat-components.git"
  },
  "files": [
    "dist",
    "skills",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "customElements": "./dist/custom-elements.json",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "./dist/components-extra/U*.js",
    "./src/components-extra/U*.ts",
    "./dist/components/*/U*.js",
    "./src/components/*/U*.ts",
    "./dist/extra.js",
    "./src/extra.ts",
    "./dist/index.js",
    "./src/index.ts",
    "./dist/utilities/icons.js",
    "./src/utilities/icons.ts",
    "./dist/react/index.js"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./extra": "./src/extra.js",
    "./dist/*": "./src/*",
    "./react": "./dist/react/index.js",
    "./react/*": "./dist/react/*"
  },
  "scripts": {
    "preversion": "node -e \"if(require('fs').existsSync('../../scripts/preversion-check.mjs'))require('child_process').execFileSync('node',['../../scripts/preversion-check.mjs'],{stdio:'inherit'})\"",
    "start": "vite",
    "analyze": "cem analyze",
    "build": "npm run typecheck && eslint && vite build && npm run analyze",
    "pretest": "node -e \"if(require('fs').existsSync('../../scripts/sibling-dist-check.js'))require('child_process').execFileSync('node',['../../scripts/sibling-dist-check.js'],{stdio:'inherit'})\"",
    "test": "vitest run --project=unit --project=browser",
    "test:webkit": "vitest run --project=webkit",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "lit": "^3.3.3",
    "marked": "^18.2.0"
  },
  "peerDependencies": {
    "@iyulab/components": ">=3.2.0",
    "@lit/react": "^1.0.8",
    "chart.js": "^4.5.1",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@lit/react": {
      "optional": true
    },
    "chart.js": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^10.0.1",
    "@iyulab/components": "^3.2.0",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "^5.1.0",
    "chart.js": "^4.6.1",
    "eslint": "^10.15.0",
    "eslint-plugin-lit": "^2.3.1",
    "glob": "^14.0.6",
    "globals": "^17.14.0",
    "openai": "^7.57.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0"
  }
}
