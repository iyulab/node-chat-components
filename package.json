    "marked-katex-extension": "^5.1.10"
  },
  "peerDependencies": {
    "@lit/react": ">=1.0.8",
    "chart.js": ">=4.5.1",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@lit/react": {
      "optional": true
    },
    "chart.js": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^26.1.0",
    "chart.js": "^4.5.1",
    "eslint": "^9.39.4",
    "eslint-plugin-lit": "^2.3.1",
    "glob": "^13.0.6",
    "globals": "^17.7.0",
    "openai": "^6.45.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.3",
    "vite-plugin-dts": "^5.0.3"
  }
}