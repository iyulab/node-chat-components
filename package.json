{
  "name": "@iyulab/chat-components",
  "description": "llm chat components for building chat interfaces",
  "version": "0.1.0",
  "author": "iyulab",
  "license": "MIT",
  "keywords": [
    "llm",
    "ai",
    "chat",
    "conversation",
    "components",
    "web components"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/iyulab/node-chat-components.git"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./styles/*": "./src/assets/styles/*",
    "./components": "./src/components/index.js",
    "./components/*": "./src/components/*",
    "./events": "./src/events/index.js",
    "./events/*": "./src/events/*",
    "./utilities": "./src/utilities/index.js",
    "./utilities/*": "./src/utilities/*"
  },
  "scripts": {
    "build": "eslint && vite build"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.1",
    "dompurify": "^3.2.6",
    "highlight.js": "^11.11.1",
    "lit": "^3.3.0",
    "marked": "^15.0.12",
    "marked-alert": "^2.1.2",
    "marked-footnote": "^1.2.4",
    "marked-katex-extension": "^5.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^24.0.1",
    "eslint": "^9.28.0",
    "eslint-plugin-lit": "^2.1.1",
    "globals": "^16.2.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-static-copy": "^3.0.0"
  }
}
